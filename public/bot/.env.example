# .env.example
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# ==========================================
# Discord (обязательно!)
# ==========================================

# Токен бота Discord
# Получить: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Префикс команд (для legacy команд)
BOT_PREFIX=!

# ==========================================
# База данных
# ==========================================

# Путь к файлу базы данных SQLite
DB_PATH=data/bot_database.db

# ==========================================
# Веб-сервер (Flask API)
# ==========================================

# Порт веб-сервера (доступ к панели управления)
WEB_PORT=5000

# Хост веб-сервера
WEB_HOST=0.0.0.0

# Секретный ключ для Flask (измените в продакшене!)
SECRET_KEY=change-me-to-random-string

# Разрешённые CORS origins (через запятую, или * для всех)
CORS_ORIGINS=*

# ==========================================
# Настройки модерации
# ==========================================

# ID канала для логов модерации
# Правый клик на канал → Copy ID (нужен режим разработчика)
LOG_CHANNEL_ID=0

# ID роли модератора
MOD_ROLE_ID=0

# Максимум предупреждений до авто-бана
MAX_WARNINGS=3
